---
import { formacion, type EstadoFormacion } from '@/data/formacion'

const titulaciones = formacion.filter((item) => item.tipo === 'titulacion')
const certificaciones = formacion.filter((item) => item.tipo === 'certificacion')

const estados: Record<
  EstadoFormacion,
  { label: string; clases: string }
> = {
  completado: {
    label: 'Completado',
    clases:
      'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-400',
  },
  'en-curso': {
    label: 'En curso',
    clases:
      'border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-400',
  },
  'en-preparacion': {
    label: 'En preparación',
    clases:
      'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-400',
  },
  objetivo: {
    label: 'Objetivo',
    clases:
      'border-zinc-200 bg-zinc-100 text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400',
  },
}

const grupos = [
  {
    titulo: 'Titulaciones oficiales',
    items: titulaciones,
    icono: 'titulacion',
  },
  {
    titulo: 'Certificaciones de ciberseguridad',
    items: certificaciones,
    icono: 'certificacion',
  },
] as const
---

<section id="formacion" class="mt-20 px-4">
    <div class="text-center mb-8">
        <h2
            class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mb-2"
        >
            Formación y certificaciones
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-lg mx-auto">
            Titulaciones oficiales y certificaciones técnicas, con su estado
            actual.
        </p>
    </div>

    <div class="flex flex-col gap-8 max-w-4xl mx-auto">
        {
            grupos.map((grupo) => (
                <div>
                    <h3 class="flex items-center gap-2 mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                        {grupo.icono === 'titulacion' ? (
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.8"
                                stroke="currentColor"
                                class="w-4 h-4"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
                                />
                            </svg>
                        ) : (
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.8"
                                stroke="currentColor"
                                class="w-4 h-4"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
                                />
                            </svg>
                        )}
                        {grupo.titulo}
                    </h3>

                    <div
                        class={`grid gap-3 ${
                            grupo.icono === 'titulacion'
                                ? 'sm:grid-cols-2'
                                : 'sm:grid-cols-3'
                        }`}
                    >
                        {grupo.items.map((item) => {
                            const estado = estados[item.estado]
                            return (
                                <article class="rounded-xl border border-zinc-200 bg-white p-4 transition-all hover:border-zinc-300 hover:shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700">
                                    <div class="flex items-start justify-between gap-3">
                                        <h4 class="text-sm font-semibold text-zinc-900 dark:text-white">
                                            {item.titulo}
                                        </h4>
                                        <span
                                            class={`shrink-0 rounded-full border px-2 py-0.5 text-[10px] font-medium ${estado.clases}`}
                                        >
                                            {estado.label}
                                        </span>
                                    </div>
                                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                                        {item.entidad}
                                        {item.periodo && ` · ${item.periodo}`}
                                    </p>
                                    <p class="mt-2 text-xs leading-relaxed text-zinc-500 dark:text-zinc-500">
                                        {item.descripcion}
                                    </p>
                                </article>
                            )
                        })}
                    </div>
                </div>
            ))
        }
    </div>
</section>

---
import Layout from "@/layouts/Layout.astro";
import { cloudinaryUrl } from "@/lib/cloudinary";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const proyectos = await getCollection("proyectos");
    return proyectos.map((p) => ({
        params: { id: p.data.route ?? p.id },
        props: { entry: p },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const heroImg = entry.data.heroImage
    ? cloudinaryUrl(entry.data.heroImage)
    : null;
const tags = entry.data.tags ?? [];
const pubDate = new Date(entry.data.pubDate).toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<Layout>
    <a
        href="/#proyectos"
        class="fixed top-20 left-4 sm:left-8 z-40 flex items-center gap-2 rounded-full bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md px-4 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-black dark:hover:text-white border border-zinc-200/50 dark:border-zinc-700/50 shadow-sm transition-colors"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
        >
        Volver
    </a>

    {
        heroImg ? (
            <div class="relative w-full h-[60vh] min-h-[400px] overflow-hidden">
                <img
                    src={heroImg}
                    alt={entry.data.title}
                    class="h-full w-full object-cover"
                    style={`view-transition-name: proyecto-hero-${entry.data.heroImage}`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent" />
                <div class="absolute bottom-0 left-0 right-0 p-8 sm:p-16 max-w-6xl mx-auto">
                    <h1
                        class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight"
                        style={`view-transition-name: proyecto-title-${entry.data.title}`}
                    >
                        {entry.data.title}
                    </h1>
                </div>
            </div>
        ) : (
            <h1
                class="text-3xl sm:text-5xl font-extrabold text-black dark:text-white tracking-tight pt-8 px-4 sm:px-8 max-w-6xl mx-auto"
                style={`view-transition-name: proyecto-title-${entry.data.title}`}
            >
                {entry.data.title}
            </h1>
        )
    }

    <div
        class="max-w-6xl mx-auto px-4 sm:px-8 py-12 flex flex-col lg:flex-row gap-12"
    >
        <aside class="lg:w-64 shrink-0">
            <div class="lg:sticky lg:top-24 space-y-6">
                <div>
                    <h4
                        class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2"
                    >
                        Fecha
                    </h4>
                    <p class="text-sm text-zinc-600 dark:text-zinc-300">
                        {pubDate}
                    </p>
                </div>

                {
                    tags.length > 0 && (
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2">
                                Stack
                            </h4>
                            <div class="flex flex-wrap gap-1.5">
                                {tags.map((tag) => (
                                    <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )
                }

                <div>
                    <h4
                        class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2"
                    >
                        Enlaces
                    </h4>
                    <div class="flex flex-col gap-2">
                        {
                            entry.data.githubRepo && (
                                <a
                                    href={entry.data.githubRepo}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-colors"
                                >
                                    <img
                                        src="/svg/github-mark.png"
                                        alt=""
                                        width={16}
                                        height={16}
                                    />
                                    GitHub
                                </a>
                            )
                        }
                        {
                            entry.data.demoLink && (
                                <a
                                    href={entry.data.demoLink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-colors"
                                >
                                    <img
                                        src="/svg/hyperlink.png"
                                        alt=""
                                        width={18}
                                        height={18}
                                    />
                                    Demo en vivo
                                </a>
                            )
                        }
                    </div>
                </div>
            </div>
        </aside>

        <article class="flex-1 min-w-0 prose prose-lg max-w-none">
            <Content />
        </article>
    </div>
</Layout>

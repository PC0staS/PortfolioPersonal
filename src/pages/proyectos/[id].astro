---
import Layout from '@/layouts/Layout.astro'
import Navbar from '@/components/Navbar'
import ProyectoHeroImage from '@/components/ProyectoHeroImage'
import { cloudinaryUrl } from '@/lib/cloudinary'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos')
  return proyectos.map((p) => ({
    params: { id: p.data.route ?? p.id },
    props: { entry: p },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const ogImage = entry.data.heroImage
  ? cloudinaryUrl(entry.data.heroImage)
  : '/img/me.jpeg'
---

<Layout>
  <Navbar client:load />
  <div class="max-w-3xl mx-auto mt-12 p-4 text-black dark:text-white">
    <a href="/#proyectos" class="text-gray-600 dark:text-gray-400 hover:underline transition-all">
      Volver a los proyectos
    </a>
    <div class="flex flex-col items-center">
      <ProyectoHeroImage
        client:load
        src={entry.data.heroImage}
        alt={entry.data.title}
      />
      <h1
        class="text-4xl font-bold mb-8 text-center"
        style={`view-transition-name: proyecto-title-${entry.data.title}`}
      >
        {entry.data.title}
      </h1>
    </div>
    <article class="prose prose-lg mx-auto">
      <Content />
    </article>
  </div>
</Layout>

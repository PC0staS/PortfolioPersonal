---
import Layout from '@/layouts/Layout.astro'
import MainScreen from '@/components/MainScreen'
import Formacion from '@/components/Formacion.astro'
import ExpWith from '@/components/ExpWith'
import ProyectosSection from '@/components/ProyectosSection.astro'
import Contacto from '@/components/Contacto.astro'
import { profileImageUrl } from '@/lib/cloudinary'
---

<Layout>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={profileImageUrl(400)}
      imagesrcset={`${profileImageUrl(400)} 1x, ${profileImageUrl(800)} 2x`}
      imagesizes="200px"
      fetchpriority="high"
    />
  </Fragment>
  <div class="max-w-6xl mx-auto min-h-screen px-4 sm:px-6 lg:px-8">
    <MainScreen client:load />
    <Formacion />
    <ExpWith client:load />
    <ProyectosSection />
  </div>
  <Contacto />
</Layout>
